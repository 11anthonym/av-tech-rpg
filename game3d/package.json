{
  "name": "av-tech-rpg-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "build": "tsc --noEmit && vite build",
    "build:portable": "tsc --noEmit && vite build --base=/ --outDir dist-portable",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:browser": "playwright test",
    "test:public": "playwright test --config=playwright.public.config.ts",
    "check": "pnpm test && pnpm build && pnpm build:portable && pnpm test:browser"
  },
  "dependencies": {
    "@babylonjs/core": "9.37.1",
    "@babylonjs/loaders": "9.37.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.10.1",
    "gltf-validator": "2.0.0-dev.3.10",
    "mikktspace": "1.1.1",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
